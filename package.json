    "@deepseek-ai/dsh-subagent": "0.2.2-rc.1",
    "@deepseek-ai/dsh-tool-executor-ptc": "0.2.2-rc.1",
    "@deepseek-ai/dsh-tool-todo": "0.2.2-rc.1",
    "@deepseek-ai/dsh-tools": "0.2.2-rc.1",
    "@deepseek-ai/dsh-user-approval": "0.2.2-rc.1",
    "@deepseek-ai/dsh-util-code-language": "0.2.2-rc.1",
    "@deepseek-ai/dsh-util-file-drag": "0.2.2-rc.1",
    "@deepseek-ai/dsh-working-directory": "0.2.2-rc.1",
    "@deepseek-ai/dsh-workspace": "0.2.2-rc.1",
    "@shikijs/langs": "4.4.3",
    "@types/js-yaml": "4.0.9",
    "@types/mdast": "4.0.4",
    "@types/node": "24.19.2",
    "@types/react": "18.3.31",
    "jsdom": "29.1.1",
    "lexical": "0.49.0",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  }
}
