{
  "name": "@local/decision-review",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Per-tool-call Auto review with a pluggable engine: OpenAI Decisions API (typed predicates + deterministic composition) or the official session-model mirror review.",
  "scripts": {
    "build": "bun run toolchain:check && bun run build:ui-css && bun scripts/build.ts",
    "typecheck": "bun run toolchain:check && bun check --no-script -p tsconfig.server.json && bun check --no-script -p tsconfig.client.json && bun check --no-script -p tsconfig.scripts.json && bun check --no-script -p tsconfig.preview.json",
    "lint": "bun run toolchain:check && bun lint --no-script --max-warnings=0 src scripts test preview",
    "fmt": "bun run toolchain:check && bun fmt --no-script --no-editorconfig src scripts test preview assets components.json package.json tsconfig*.json bunfig.toml .github",
    "fmt:check": "bun run toolchain:check && bun fmt --no-script --check --no-editorconfig src scripts test preview assets components.json package.json tsconfig*.json bunfig.toml .github",
    "test": "bun run build && bun --no-env-file test --isolate ./test ./preview/service.test.ts ./preview/verifier.test.js ./preview/scoped-css.test.js",
    "test:ci": "bun run build && mkdir -p artifacts/test && bun --no-env-file test --isolate --parallel=2 --randomize --seed=963452075 --coverage --reporter=junit --reporter-outfile=artifacts/test/junit.xml ./test ./preview/service.test.ts ./preview/verifier.test.js ./preview/scoped-css.test.js",
    "check": "bun run typecheck && bun run lint && bun run fmt:check && bun run test",
    "pack": "bun run build && cd dist && bun pm pack --destination ../artifacts",
    "toolchain:check": "bun scripts/check-toolchain.ts",
    "verify:package": "bun run toolchain:check && bun scripts/verify-package.ts",
    "verify:host": "python3 scripts/verify-host.py",
    "dev": "bun run toolchain:check && bun run build:ui-css && bun --no-env-file preview/server.ts",
    "test:preview": "bun run toolchain:check && bun --no-env-file test --isolate ./preview/service.test.ts ./preview/verifier.test.js ./preview/scoped-css.test.js",
    "verify:preview": "bun run toolchain:check && bun --no-env-file scripts/verify-preview.mjs",
    "build:ui-css": "bun scripts/build-ui-css.ts"
  },
  "packageManager": "bun@1.4.3-canary.20261021.1",
  "engines": {
    "node": ">=24.9.0",
    "bun": "1.4.4-canary.1",
    "dsh": "0.2.2-rc.1 || 0.2.2-rc.2 || 0.2.2-rc.3"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.1.0",
