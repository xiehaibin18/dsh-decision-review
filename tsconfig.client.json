{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "types": [
      "react"
    ],
    "lib": [
      "ES2024",
      "DOM",
      "DOM.Iterable",
      "ESNext.Disposable"
    ],
    "preserveSymlinks": true
  },
  "include": [
    "src/client/**/*.ts",
    "src/client/**/*.tsx",
    "src/shared/**/*.ts"
  ]
}
